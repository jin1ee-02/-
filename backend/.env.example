# ── LLM 연결 ────────────────────────────────────────────────────────────────
# 여기에 키만 넣으면 실제 LLM으로 전환됩니다. 비어 있으면 오프라인 규칙(offline/rules-v1)으로 동작합니다.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# auto: 키가 있으면 openai, 없으면 offline / openai / offline
LLM_PROVIDER=auto
# auto: LLM_PROVIDER를 따름 / openai / jev(TypeSafe 분류 모델) / offline
ANALYSIS_PROVIDER=auto
TYPESAFE_API_KEY=your_typesafe_key_here
JEV_MODEL=jev-1.13.0

# ── 실행 설정 ────────────────────────────────────────────────────────────────
DATABASE_PATH=data/mvp.sqlite3
MODEL_CONCURRENCY=4
# 다툼판결: 최대 라운드와 조기 종료(adaptive stopping) 기준
VERDICT_MAX_ROUNDS=3
VERDICT_STABILITY_DELTA=5
VERDICT_BELIEF_DELTA=0.1
# 심사위원 수(1~3)와 심사위원 의견 분포의 라운드 간 KS 거리 허용치
VERDICT_JUDGES=3
VERDICT_KS_DELTA=0.34
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
